# ─────────────────────────────────────────────────────────────
# GannaApp — environment configuration
# Copy to `.env` on the server and fill in real values.
# NEVER commit the real .env (it is gitignored).
# ─────────────────────────────────────────────────────────────

# Node environment. Use "production" on the Lightsail server.
NODE_ENV=production

# Port the Node process listens on. nginx proxies :80 -> this port.
PORT=4000

# ── MySQL (running on the same Lightsail instance) ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=ganna
DB_PASSWORD=
DB_NAME=ganna

# ── Auth ──
# MANDATORY in production — the server refuses to issue tokens without it.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=

# ── CORS ──
# Frontend and backend are served from the same origin on Lightsail,
# so this is only needed if you ever split them onto separate hosts.
FRONTEND_ORIGIN=http://localhost:5173
